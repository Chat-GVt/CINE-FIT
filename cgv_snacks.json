    "step0_hard_filter": {
      "설명": "★ 유사도 계산보다 먼저. 여기서 걸리면 후보에서 완전 제외.",
      "rules": [
        "category == '소스'                                    → 항상 제외 (옵션 상품)",
        "is_alcohol == true && 유저 연령 미확인                  → 제외",
        "linked_movie != null && linked_movie != 추천영화.title  → 제외 (다른 영화 굿즈)"
      ]
    },
    "step1_manner_filter": {
      "설명": "★ 관람 매너 필터. 이 프로젝트의 차별점.",
      "rules": [
        "영화 F < -0.3 (느린 영화)       → noise_level ≤ 3",
        "영화 F < -0.6 (매우 느린 영화)   → noise_level ≤ 2",
        "영화 P < -0.5 (독립·예술영화)    → noise_level ≤ 2 AND smell_level ≤ 2",
        "그 외                          → 전체 후보"
      ],
      "왜": "「침묵의 친구」(148분, 느린 호흡) 보러 가는 사람에게 통통오징어(noise 5, smell 3)를 추천하면 안 됩니다. 기존 영화관 앱은 이걸 구분하지 않습니다."
    },
    "step2_similarity": {
      "formula": "cosine(movie.vector, item.pairing_vector)",
      "output": "콤보 1개, 또는 음료 1 + 스낵 1"
    },
    "step3_ip_boost": {
      "rule": "item.linked_movie == 추천영화.title → 최상단 강제 노출",
      "예시": "「사랑의 하츄핑」 추천 시 → '하츄핑 키링 음료세트' 최우선"
    }
  },

